# Copy this file to .env and fill in your keys. Never commit .env.

# OpenRouter key (openrouter.ai/settings/keys). Pays for Jev.
OPENROUTER_API_KEY=

# Jev model on OpenRouter. 1.14 reads text + images. Pin it so results stay comparable between runs.
JEV_MODEL=typesafe/jev-1.14

# Apify token (console.apify.com → Settings → API & Integrations). Pays for scraping Ad Library.
APIFY_TOKEN=
